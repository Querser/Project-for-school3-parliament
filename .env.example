# Application
# NODE_ENV is set automatically by Next.js:
# - next dev -> development
# - next build / next start -> production
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-super-secret

# Database
# For local docker-compose PostgreSQL use host localhost:5433
DATABASE_URL=postgresql://school_parliament:school_parliament@localhost:5433/school_parliament?schema=public

# Storage
STORAGE_ROOT=./storage
MAX_IMAGE_SIZE_MB=5
MAX_DOCUMENT_SIZE_MB=15

# Seed admin
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=admin12345
PRESIDENT_SEED_USERNAME=president
PRESIDENT_SEED_PASSWORD=president12345
MINISTER_SEED_USERNAME=minister
MINISTER_SEED_PASSWORD=minister12345

# Auth hardening
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_MAX_FAILED_ATTEMPTS_PER_IP=12
AUTH_MAX_FAILED_ATTEMPTS_PER_USERNAME=6
MAX_ACTIVE_ADMIN_SESSIONS=3
